@model tripop_8021_lab006.Models.UserViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="max-w-md mx-auto mt-10 p-6 bg-white rounded-xl border border-slate-200 shadow-sm">
    <h1 class="text-2xl font-bold text-slate-900 mb-4">เข้าสู่ระบบ (Login)</h1>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="mb-4 p-3 rounded-lg bg-red-50 text-red-600 text-sm border border-red-200">
            @ViewBag.ErrorMessage
        </div>
    }

    <form asp-controller="Login" asp-action="Login" method="post" class="space-y-4">
        <div>
            <label asp-for="UserName" class="block text-sm font-medium text-slate-700 mb-1">UserName</label>
            <input asp-for="UserName" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-slate-700 mb-1">Password</label>
            <input asp-for="Password" type="password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </div>

        <button type="submit" class="w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">
            เข้าสู่ระบบ
        </button>
    </form>

    <div class="mt-4 text-center text-sm text-slate-600">
        ยังไม่มีบัญชี? <a asp-controller="Login" asp-action="Register" class="text-indigo-600 hover:underline">สมัครสมาชิก</a>
    </div>
</div>
