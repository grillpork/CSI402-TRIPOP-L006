@model tripop_8021_lab006.Models.UserViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="max-w-md mx-auto mt-8 p-6 bg-white rounded-xl border border-slate-200 shadow-sm">
    <h1 class="text-xl font-bold text-slate-900 mb-4">เพิ่มผู้ใช้ใหม่ (CreateUser)</h1>

    <form asp-action="CreateUser" method="post" class="space-y-4">
        <div>
            <label asp-for="UserName" class="block text-sm font-medium text-slate-700 mb-1">UserName</label>
            <input asp-for="UserName" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
            <input asp-for="Email" type="email" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-slate-700 mb-1">Password</label>
            <input asp-for="Password" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </div>

        <div class="flex gap-2">
            <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">
                บันทึก
            </button>
            <a asp-action="UserList" class="rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50">
                ยกเลิก
            </a>
        </div>
    </form>
</div>
