@model tripop_8021_lab006.Models.User
@{
    ViewData["Title"] = "Edit User";
}

<div class="max-w-md mx-auto my-8 p-6 bg-white border border-gray-200 rounded">
    <h2 class="text-xl font-bold text-gray-800 mb-4">แก้ไขผู้ใช้ (Edit User)</h2>

    <form asp-action="EditUser" method="post" class="space-y-4">
        <input type="hidden" asp-for="UserId" />

        <div>
            <label asp-for="UserName" class="block text-sm font-medium text-gray-700 mb-1">UserName</label>
            <input asp-for="UserName" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-blue-500" required />
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input asp-for="Email" type="email" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-blue-500" />
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
            <input asp-for="Password" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-blue-500" />
        </div>

        <div class="flex gap-2 pt-2">
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">
                บันทึกการแก้ไข
            </button>
            <a asp-action="UserList" class="px-4 py-2 bg-gray-200 text-gray-700 rounded text-sm hover:bg-gray-300">
                ยกเลิก
            </a>
        </div>
    </form>
</div>
