@model tripop_8021_lab006.Models.User
@{
    ViewData["Title"] = "Edit User - แก้ไขข้อมูลผู้ใช้";
}

<div class="max-w-xl mx-auto py-6 sm:py-10 px-4">
    <!-- Breadcrumb / Back button -->
    <div class="mb-6">
        <a asp-action="UserList" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-indigo-600 transition">
            <i data-lucide="arrow-left" class="h-4 w-4"></i>
            <span>กลับไปยังรายชื่อผู้ใช้ (User List)</span>
        </a>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
        <!-- Header -->
        <div class="flex items-center gap-3 mb-6 pb-6 border-b border-slate-100">
            <div class="h-12 w-12 rounded-2xl bg-amber-50 text-amber-600 border border-amber-100 flex items-center justify-center font-bold">
                <i data-lucide="user-cog" class="h-6 w-6"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-slate-900">แก้ไขผู้ใช้งาน (Edit User)</h1>
                <p class="text-xs text-slate-500 mt-0.5">แก้ไขชื่อผู้ใช้ อีเมล และรหัสผ่านของ User ID #@Model.UserId</p>
            </div>
        </div>

        <form asp-action="EditUser" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />

            <!-- User ID Display -->
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">User ID</label>
                <div class="inline-flex items-center px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-xs font-mono font-bold text-slate-700 w-full sm:w-auto">
                    #@Model.UserId
                </div>
            </div>

            <!-- UserName -->
            <div>
                <label asp-for="UserName" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                    ชื่อผู้ใช้ (UserName)
                </label>
                <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i data-lucide="user" class="h-4 w-4"></i>
                    </div>
                    <input asp-for="UserName"
                           required
                           class="w-full rounded-xl border border-slate-300 pl-10 pr-4 py-2.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition"
                           placeholder="ระบุชื่อผู้ใช้" />
                </div>
            </div>

            <!-- Email -->
            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                    อีเมล (Email)
                </label>
                <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i data-lucide="mail" class="h-4 w-4"></i>
                    </div>
                    <input asp-for="Email"
                           type="email"
                           class="w-full rounded-xl border border-slate-300 pl-10 pr-4 py-2.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition"
                           placeholder="user@example.com" />
                </div>
            </div>

            <!-- Password -->
            <div>
                <label asp-for="Password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                    รหัสผ่าน (Password)
                </label>
                <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i data-lucide="lock" class="h-4 w-4"></i>
                    </div>
                    <input asp-for="Password"
                           type="text"
                           class="w-full rounded-xl border border-slate-300 pl-10 pr-4 py-2.5 text-sm font-mono focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition"
                           placeholder="ระบุรหัสผ่านใหม่" />
                </div>
            </div>

            <!-- Action buttons -->
            <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700 shadow-md shadow-indigo-600/20 active:scale-95 transition">
                    <i data-lucide="save" class="h-4 w-4"></i>
                    <span>บันทึกการแก้ไข (Save Changes)</span>
                </button>
                <a asp-action="UserList"
                   class="rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">
                    ยกเลิก (Cancel)
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}
