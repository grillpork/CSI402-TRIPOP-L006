@model tripop_8021_lab006.Models.User
@{
    ViewData["Title"] = "User Details";
}

<div class="max-w-md mx-auto mt-8 p-6 bg-white rounded-xl border border-slate-200 shadow-sm">
    <h1 class="text-xl font-bold text-slate-900 mb-4">รายละเอียดผู้ใช้ (Details)</h1>

    @if (Model != null)
    {
        <dl class="space-y-2 text-sm">
            <div><dt class="font-semibold text-slate-600">UserId:</dt><dd>@Model.UserId</dd></div>
            <div><dt class="font-semibold text-slate-600">UserName:</dt><dd>@Model.UserName</dd></div>
            <div><dt class="font-semibold text-slate-600">Email:</dt><dd>@Model.Email</dd></div>
            <div><dt class="font-semibold text-slate-600">Password:</dt><dd>@Model.Password</dd></div>
        </dl>
    }

    <div class="mt-6">
        <a asp-action="UserList" class="rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50">
            กลับหน้ารายการ
        </a>
    </div>
</div>
