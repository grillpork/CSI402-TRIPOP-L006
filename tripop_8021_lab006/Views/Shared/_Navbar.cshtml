<nav class="bg-white/80 backdrop-blur-md border-b border-slate-200 sticky top-0 z-50 transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <div class="flex items-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group">
                    <span
                        class="font-bold text-xl bg-gradient-to-r text-blue-500 from-slate-900 to-slate-700 bg-clip-text text-transparent">
                        Fluck Fashion
                    </span>
                </a>

                <div class="hidden md:ml-8 md:flex md:space-x-2">
                    <a asp-area="" asp-controller="Admin" asp-action="#cart"
                       class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-indigo-600 hover:bg-slate-50 transition-colors">
                        <span>ร้านค้า</span>
                    </a>
                    <a asp-area="" asp-controller="Admin" asp-action="#cart"
                       class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-indigo-600 hover:bg-slate-50 transition-colors">
                        <span>รายการโปรด</span>
                    </a>
                </div>
            </div>

            <div class="h-full flex items-center gap-3">
                <div class="hidden sm:flex items-center gap-3">
                    <button type="button" title="การแจ้งเตือน" class="p-2 text-slate-500 hover:text-indigo-600 hover:bg-slate-50 rounded-lg transition-colors">
                        <i data-lucide="bell" class="h-4 w-4"></i>
                    </button>
                    <button type="button" title="ตะกร้าสินค้า" class="p-2 text-slate-500 hover:text-indigo-600 hover:bg-slate-50 rounded-lg transition-colors">
                        <i data-lucide="shopping-cart" class="h-4 w-4"></i>
                    </button>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex items-center gap-3 pl-2 border-l border-slate-200">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="hidden sm:block text-left leading-tight">
                                <div class="text-xs font-semibold text-slate-800">@User.Identity.Name</div>
                                <div class="text-[10px] text-indigo-600 font-medium">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")</div>
                            </div>
                        </div>

                        <a asp-controller="Auth" asp-action="Logout"
                           title="ออกจากระบบ"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-rose-600 hover:bg-rose-50 border border-rose-200 transition">
                            <i data-lucide="log-out" class="h-3.5 w-3.5"></i>
                            <span class="hidden sm:inline">ออกจากระบบ</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-2 pl-2">
                        <a asp-controller="Auth" asp-action="Login"
                           class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-medium text-slate-700 hover:text-indigo-600 hover:bg-slate-50 transition">
                            <i data-lucide="log-in" class="h-3.5 w-3.5"></i>
                            <span>เข้าสู่ระบบ</span>
                        </a>
                        <a asp-controller="Auth" asp-action="Register"
                           class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm active:scale-95 transition">
                            <i data-lucide="user-plus" class="h-3.5 w-3.5"></i>
                            <span>สมัครสมาชิก</span>
                        </a>
                    </div>
                }
            </div>

            <div class="flex items-center md:hidden">
                <button id="mobile-menu-button" type="button"
                        class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        aria-controls="mobile-menu" aria-expanded="false">
                    <span class="sr-only">Open main menu</span>
                    <i id="menu-icon-closed" data-lucide="menu" class="block h-6 w-6"></i>
                    <i id="menu-icon-opened" data-lucide="x" class="hidden h-6 w-6"></i>
                </button>
            </div>
        </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white/95 backdrop-blur-md">
        <div class="px-4 pt-3 pb-4 space-y-1">
            <a asp-area="" asp-controller="Home" asp-action="Index"
               class="flex items-center gap-2 px-3 py-2 rounded-md text-base font-medium text-slate-800 hover:text-indigo-600 hover:bg-slate-50 transition-colors">
                <i data-lucide="house" class="h-4 w-4"></i>
                <span>หน้าแรก</span>
            </a>
            <a asp-area="" asp-controller="User" asp-action="Userlist"
               class="flex items-center gap-2 px-3 py-2 rounded-md text-base font-medium text-slate-800 hover:text-indigo-600 hover:bg-slate-50 transition-colors">
                <i data-lucide="users" class="h-4 w-4"></i>
                <span>รายชื่อผู้ใช้</span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="pt-3 border-t border-slate-200 mt-2">
                    <div class="flex items-center gap-2 px-3 py-2 text-sm text-slate-600">
                        <i data-lucide="user-check" class="h-4 w-4 text-indigo-600"></i>
                        <span>เข้าสู่ระบบในชื่อ: <strong>@User.Identity.Name</strong> (@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User"))</span>
                    </div>
                    <a asp-controller="Auth" asp-action="Logout"
                       class="w-full flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-lg transition mt-2">
                        <i data-lucide="log-out" class="h-4 w-4"></i>
                        <span>ออกจากระบบ</span>
                    </a>
                </div>
            }
            else
            {
                <div class="pt-3 border-t border-slate-200 mt-2 grid grid-cols-2 gap-2">
                    <a asp-controller="Auth" asp-action="Login"
                       class="flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium border border-slate-300 text-slate-700 hover:bg-slate-50 transition">
                        <i data-lucide="log-in" class="h-4 w-4"></i>
                        <span>เข้าสู่ระบบ</span>
                    </a>
                    <a asp-controller="Auth" asp-action="Register"
                       class="flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition">
                        <i data-lucide="user-plus" class="h-4 w-4"></i>
                        <span>สมัครสมาชิก</span>
                    </a>
                </div>
            }
        </div>
    </div>
</nav>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) {
            window.lucide.createIcons();
        }

        const menuBtn = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        const iconClosed = document.getElementById('menu-icon-closed');
        const iconOpened = document.getElementById('menu-icon-opened');

        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', () => {
                const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
                menuBtn.setAttribute('aria-expanded', String(!isExpanded));
                mobileMenu.classList.toggle('hidden');
                iconClosed.classList.toggle('hidden');
                iconOpened.classList.toggle('hidden');
            });
        }
    });
</script>
