@model tripop_8021_lab006.Models.LabStudent

<h2>Edit Student</h2>

<form asp-action="Lab9_Edit" asp-controller="Home" method="post">
    student ID <input type="text" asp-for="StdId" class="form-control" readonly /> <br/>
    Password <input type="password" asp-for="StdPassword" class="form-control"/> <br/>
    Name <input type="text" asp-for="StdName" class="form-control"/> <br/>
    LastName <input type="text" asp-for="StdLastname" class="form-control"/> <br/>
    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Lab9_1" class="btn btn-secondary">Cancel</a>
</form>

<p class="text-danger">@ViewBag.Status</p>

