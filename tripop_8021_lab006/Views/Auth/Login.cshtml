@{
    ViewData["Title"] = "เข้าสู่ระบบ (Login)";
}

<div class="flex min-h-[75vh] items-center justify-center py-8 px-4">
    <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-sm border border-slate-200">
        <!-- Header -->
        <div class="text-center mb-6">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 mb-3">
                <i data-lucide="log-in" class="h-6 w-6"></i>
            </div>
            <h1 class="text-2xl font-bold text-slate-900">เข้าสู่ระบบ</h1>
            <p class="text-sm text-slate-500 mt-1">ยินดีต้อนรับกลับสู่ Fluck Fashion</p>
        </div>

        <!-- Success notification -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-5 rounded-xl bg-green-50 p-3.5 text-sm text-green-700 border border-green-200 flex items-center gap-2">
                <i data-lucide="check-circle" class="h-5 w-5 text-green-500 flex-shrink-0"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <!-- Error notification -->
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="mb-5 rounded-xl bg-red-50 p-3.5 text-sm text-red-600 border border-red-200 flex items-center gap-2">
                <i data-lucide="alert-circle" class="h-5 w-5 text-red-500 flex-shrink-0"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="space-y-4">
            <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">
                    อีเมล หรือ ชื่อผู้ใช้
                </label>
                <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i data-lucide="user" class="h-4 w-4"></i>
                    </div>
                    <input type="text"
                           id="email"
                           name="email"
                           value="@ViewBag.Email"
                           required
                           class="w-full rounded-xl border border-slate-300 pl-10 pr-4 py-2.5 text-sm focus:border-indigo-500 
                           focus:outline-none focus:ring-1 focus:ring-indigo-500 transition"
                           placeholder="username หรือ user@email.com"
                           autocomplete="username" />
                </div>
            </div>

            <div>
                <label for="loginPasswordInput" class="block text-sm font-medium text-slate-700 mb-1.5">
                    รหัสผ่าน
                </label>
                <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i data-lucide="lock" class="h-4 w-4"></i>
                    </div>
                    <input type="password"
                           id="loginPasswordInput"
                           name="password"
                           required
                           class="w-full rounded-xl border border-slate-300 pl-10 pr-10 py-2.5 text-sm 
                           focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition"
                           placeholder="กรอกรหัสผ่านของคุณ"
                           autocomplete="current-password" />
                    <button type="button"
                            id="togglePasswordBtn"
                            class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-600">
                        <i id="togglePasswordIcon" data-lucide="eye" class="h-4 w-4"></i>
                    </button>
                </div>
            </div>

            <div class="flex items-center justify-between text-sm pt-1">
                <label class="flex items-center gap-2 cursor-pointer text-slate-600 select-none">
                    <input type="checkbox"
                           id="rememberMe"
                           name="rememberMe"
                           value="true"
                           class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                    <span>จดจำการเข้าสู่ระบบ</span>
                </label>
            </div>

            <button type="submit"
                    class="w-full rounded-xl bg-indigo-600 py-3 text-sm font-semibold text-white shadow-sm 
                    hover:bg-indigo-700 active:scale-[0.99] transition flex items-center justify-center gap-2">
                <i data-lucide="log-in" class="h-4 w-4"></i>
                <span>เข้าสู่ระบบ</span>
            </button>
        </form>

        <div class="mt-6 border-t border-slate-100 pt-5 text-center text-sm text-slate-500">
            ยังไม่มีบัญชีผู้ใช้?
            <a asp-action="Register" class="font-semibold text-indigo-600 hover:text-indigo-500 hover:underline">
                สมัครสมาชิกที่นี่
            </a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) {
            window.lucide.createIcons();
        }

        const toggleBtn = document.getElementById('togglePasswordBtn');
        const passInput = document.getElementById('loginPasswordInput');
        const toggleIcon = document.getElementById('togglePasswordIcon');

        if (toggleBtn && passInput && toggleIcon) {
            toggleBtn.addEventListener('click', () => {
                const isPassword = passInput.getAttribute('type') === 'password';
                passInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.setAttribute('data-lucide', isPassword ? 'eye-off' : 'eye');
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            });
        }
    });
</script>
