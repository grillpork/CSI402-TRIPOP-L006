@{
    ViewData["Title"] = "สมัครสมาชิก (Register)";
}

<div class="flex min-h-[75vh] items-center justify-center py-8 px-4">
    <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-sm border border-slate-200">
        <div class="text-center mb-6">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 mb-3">
                <i data-lucide="user-plus" class="h-6 w-6"></i>
            </div>
            <h1 class="text-2xl font-bold text-slate-900">สร้างบัญชีผู้ใช้ใหม่</h1>
            <p class="text-sm text-slate-500 mt-1">กรอกข้อมูลเพื่อลงทะเบียนเข้าสู่ระบบ Fluck Fashion</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="mb-5 rounded-xl bg-red-50 p-3.5 text-sm text-red-600 border border-red-200 flex items-center gap-2">
                <i data-lucide="alert-circle" class="h-5 w-5 text-red-500 flex-shrink-0"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <form asp-action="Register" method="post" class="space-y-4">
            <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">
                    อีเมล (Email) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i data-lucide="mail" class="h-4 w-4"></i>
                    </div>
                    <input type="email"
                           id="email"
                           name="email"
                           value="@ViewBag.Email"
                           required
                           class="w-full rounded-xl border border-slate-300 pl-10 pr-4 py-2.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition"
                           placeholder="example@email.com"
                           autocomplete="email" />
                </div>
            </div>

            <div>
                <label for="regPasswordInput" class="block text-sm font-medium text-slate-700 mb-1.5">
                    รหัสผ่าน (Password) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i data-lucide="lock" class="h-4 w-4"></i>
                    </div>
                    <input id="regPasswordInput"
                           name="password"
                           type="password"
                           required
                           minlength="6"
                           class="w-full rounded-xl border border-slate-300 pl-10 pr-10 py-2.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition"
                           placeholder="อย่างน้อย 6 ตัวอักษร"
                           autocomplete="new-password" />
                    <button type="button"
                            id="toggleRegPasswordBtn"
                            class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600">
                        <i id="toggleRegPasswordIcon" data-lucide="eye" class="h-4 w-4"></i>
                    </button>
                </div>
            </div>

            <div>
                <label for="confirmPassword" class="block text-sm font-medium text-slate-700 mb-1.5">
                    ยืนยันรหัสผ่าน (Confirm Password) <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                        <i data-lucide="shield-check" class="h-4 w-4"></i>
                    </div>
                    <input id="confirmPassword"
                           name="confirmPassword"
                           type="password"
                           required
                           minlength="6"
                           class="w-full rounded-xl border border-slate-300 pl-10 pr-4 py-2.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition"
                           placeholder="กรอกรหัสผ่านอีกครั้ง"
                           autocomplete="new-password" />
                </div>
            </div>

            <button type="submit"
                    class="w-full rounded-xl bg-indigo-600 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 active:scale-[0.99] transition flex items-center justify-center gap-2 mt-2">
                <i data-lucide="user-plus" class="h-4 w-4"></i>
                <span>ยืนยันการสมัครสมาชิก</span>
            </button>
        </form>

        <div class="mt-6 border-t border-slate-100 pt-5 text-center text-sm text-slate-500">
            มีบัญชีผู้ใช้อยู่แล้ว?
            <a asp-action="Login" class="font-semibold text-indigo-600 hover:text-indigo-500 hover:underline">
                เข้าสู่ระบบที่นี่
            </a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) {
            window.lucide.createIcons();
        }

        const toggleBtn = document.getElementById('toggleRegPasswordBtn');
        const passInput = document.getElementById('regPasswordInput');
        const toggleIcon = document.getElementById('toggleRegPasswordIcon');

        if (toggleBtn && passInput && toggleIcon) {
            toggleBtn.addEventListener('click', () => {
                const isPassword = passInput.getAttribute('type') === 'password';
                passInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.setAttribute('data-lucide', isPassword ? 'eye-off' : 'eye');
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            });
        }
    });
</script>
