<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - tripop_8021_lab006</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anuphan:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/tripop_8021_lab006.styles.css" asp-append-version="true" />
</head>

<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col" style="font-family: 'Anuphan', sans-serif;">
    <header>
        <partial name="_Navbar" />
    </header>

    <main role="main" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @RenderBody()
    </main>

    <footer class="bg-white text-black mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid gap-8 md:grid-cols-4">
                <div class="space-y-4">
                    <div class="flex items-center gap-3">
                        
                        <div>
                            <div class="text-lg font-bold text-black">Fluck Fashion</div>
                        </div>
                    </div>
                    <p class="text-sm leading-6 text-black">
                        แพลตฟอร์มแฟชั่นที่รวบรวมสไตล์ใหม่แรง จากการแต่งกายสบาย ๆ ถึงไลฟ์สไตล์ระดับ premium
                    </p>
                </div>

                <div>
                    <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-black">เมนู</h3>
                    <ul class="space-y-3 text-sm text-black">
                        <li><a href="#" class="text-black transition hover:text-gray-600">หน้าแรก</a></li>
                        <li><a href="#" class="text-black transition hover:text-gray-600">ร้านค้า</a></li>
                        <li><a href="#" class="text-black transition hover:text-gray-600">สินค้า</a></li>
                        <li><a href="#" class="text-black transition hover:text-gray-600">ค้นหา</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-black">บริการ</h3>
                    <ul class="space-y-3 text-sm text-black">
                        <li><a href="#" class="text-black transition hover:text-gray-600">การจัดส่ง</a></li>
                        <li><a href="#" class="text-black transition hover:text-gray-600">คืนสินค้า</a></li>
                        <li><a href="#" class="text-black transition hover:text-gray-600">การชำระเงิน</a></li>
                        <li><a href="#" class="text-black transition hover:text-gray-600">ช่วยเหลือ</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-black">ติดต่อ</h3>
                    <ul class="space-y-3 text-sm text-black">
                        <li>Bangkok, Thailand</li>
                        <li>10900</li>
                        <li>hello@fluckfashion.com</li>
                        <li>+66 2 123 4567</li>
                    </ul>
                </div>
            </div>

            <div class="mt-10 flex flex-col gap-3 border-t border-gray-200 pt-6 text-sm text-black sm:flex-row sm:items-center sm:justify-between">
                <p>© 2026 Fluck Fashion. All rights reserved.</p>
                <div class="flex items-center gap-4">
                    <a href="#" class="text-black transition hover:text-gray-600">Privacy</a>
                    <a href="#" class="text-black transition hover:text-gray-600">Terms</a>
                    <a href="#" class="text-black transition hover:text-gray-600">Support</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
