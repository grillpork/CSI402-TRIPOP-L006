<aside id="app-sidebar"
       class="hidden md:flex fixed md:sticky top-0 left-0 z-50 md:z-30 w-64 bg-white border-r border-slate-200 h-screen flex-col justify-between p-4 shrink-0 transition-all duration-300 overflow-y-auto">
    <div class="space-y-6">
        <div class="px-3 py-2 flex items-center justify-between border-b border-slate-100 pb-4">
            <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-2.5">
                <div
                    class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center font-bold shadow-md shadow-blue-500/20">
                    <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                </div>
                <div>
                    <span
                        class="font-bold text-base bg-gradient-to-r from-slate-900 to-slate-700 bg-clip-text text-transparent block leading-tight">
                        Fluck Fashion
                    </span>
                    <span
                        class="text-[10px] uppercase font-semibold tracking-wider text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded">Admin
                        Panel</span>
                    </div>
                </a>
                <button id="admin-sidebar-close" type="button"
                        class="md:hidden p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <div>
                <p class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                    เมนูหลัก
                </p>
                <nav class="space-y-1">
                    <a asp-area="" asp-controller="Admin" asp-action="Index"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-blue-600 bg-blue-50 transition-colors group">
                        <i data-lucide="layout-grid" class="w-4 h-4 text-blue-600"></i>
                        <span>ภาพรวม (Overview)</span>
                    </a>

                    <a href="#analytics"
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-blue-600 hover:bg-slate-50 transition-colors group">
                        <i data-lucide="trending-up"
                           class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors"></i>
                        <span>รายงาน & สถิติ</span>
                    </a>

                    <a href="#orders"
                       class="flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-blue-600 hover:bg-slate-50 transition-colors group">
                        <div class="flex items-center gap-3">
                            <i data-lucide="shopping-bag"
                               class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors"></i>
                            <span>คำสั่งซื้อ</span>
                        </div>
                        <span class="text-[11px] font-semibold bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full">12
                            ใหม่</span>
                        </a>

                        <a href="#products"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-blue-600 hover:bg-slate-50 transition-colors group">
                            <i data-lucide="shirt"
                               class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors"></i>
                            <span>จัดการสินค้า</span>
                        </a>

                        <a href="#customers"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-blue-600 hover:bg-slate-50 transition-colors group">
                            <i data-lucide="users"
                               class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors"></i>
                            <span>ลูกค้า & สมาชิก</span>
                        </a>
                    </nav>
                </div>

                <div>
                    <p class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
                        ระบบ
                    </p>
                    <nav class="space-y-1">
                        <a href="#settings"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-blue-600 hover:bg-slate-50 transition-colors group">
                            <i data-lucide="settings"
                               class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors"></i>
                            <span>ตั้งค่าระบบ</span>
                        </a>

                        <a asp-controller="Home" asp-action="Index"
                           class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-blue-600 hover:bg-slate-50 transition-colors group">
                            <i data-lucide="external-link"
                               class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors"></i>
                            <span>กลับไปหน้าร้านค้า</span>
                        </a>
                    </nav>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <div class="flex items-center gap-3 px-3 py-2 rounded-xl bg-slate-50">
                    <div
                        class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-semibold text-xs shrink-0">
                        TS
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-semibold text-slate-800 truncate">Tripop (006)</p>
                        <p class="text-[11px] text-slate-400 truncate">Admin / ผู้ดูแลระบบ</p>
                    </div>
                </div>
            </div>
        </aside>
