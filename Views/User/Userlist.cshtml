@model List<tripop_8021_lab006.Models.UserModel>

@{
    ViewData["Title"] = "รายชื่อผู้ใช้ (User List)";
}

<div class="max-w-5xl mx-auto py-4">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">รายชื่อผู้ใช้ทั้งหมด (User List)</h1>
            <p class="text-sm text-slate-500 mt-1">จัดการข้อมูลผู้ใช้งานและสิทธิ์ในระบบ</p>
        </div>
        <a asp-action="AddUser"
           class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700 active:scale-95 shadow-sm">
            <i data-lucide="user-plus" class="h-4 w-4"></i>
            <span>เพิ่มผู้ใช้ใหม่ (Add User)</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 rounded-xl bg-green-50 p-4 text-sm text-green-700 border border-green-200 flex items-center gap-2">
            <i data-lucide="check-circle" class="h-5 w-5 text-green-500"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="overflow-hidden rounded-2xl bg-white shadow-sm border border-slate-200">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-xs uppercase font-semibold text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4"># ID</th>
                        <th class="px-6 py-4">ชื่อ-นามสกุล</th>
                        <th class="px-6 py-4">อีเมล</th>
                        <th class="px-6 py-4">เบอร์โทรศัพท์</th>
                        <th class="px-6 py-4">บทบาท (Role)</th>
                        <th class="px-6 py-4">วันที่เพิ่ม</th>
                        <th class="px-6 py-4 text-center">จัดการ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var user in Model)
                        {
                            <tr class="hover:bg-slate-50/70 transition">
                                <td class="px-6 py-4 font-medium text-slate-900">#@user.Id</td>
                                <td class="px-6 py-4 font-semibold text-slate-900">@user.Name</td>
                                <td class="px-6 py-4 text-slate-600">@user.Email</td>
                                <td class="px-6 py-4 text-slate-500">@(string.IsNullOrEmpty(user.Phone) ? "-" : user.Phone)</td>
                                <td class="px-6 py-4">
                                    @if (user.Role == "Admin")
                                    {
                                        <span
                                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                            @user.Role
                                        </span>
                                    }
                                    else if (user.Role == "Manager")
                                    {
                                        <span
                                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                            @user.Role
                                        </span>
                                    }
                                    else
                                    {
                                        <span
                                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
                                            @user.Role
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-slate-400 text-xs">@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-6 py-4 text-center">
                                    <form asp-action="Delete" method="post"
                                          onsubmit="return confirm('ยืนยันที่จะลบผู้ใช้นี้หรือไม่?');" class="inline">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit"
                                                class="text-red-500 hover:text-red-700 p-1.5 rounded-lg hover:bg-red-50 transition"
                                                title="ลบผู้ใช้">
                                            <i data-lucide="trash-2" class="h-4 w-4"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-slate-400">
                                ไม่พบข้อมูลผู้ใช้ในระบบ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
