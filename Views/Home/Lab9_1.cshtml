@model IEnumerable<tripop_8021_lab006.Models.LabStudent>

<table class="table table-bordered">
<thead>
    <tr>
        <th>StdID</th>
        <th>StdPassword</th>
        <th>StdName</th>
        <th>StdLastname</th>
    </tr>
</thead>
<tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.StdId</td>
            <td>@item.StdPassword</td>
            <td>@item.StdName</td>
            <td>@item.StdLastname</td>
        </tr>
    }
</tbody>
</table>