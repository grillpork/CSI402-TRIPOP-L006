<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'glam-brown': '#978877',
                        'glam-gray': '#F5F5F5',
                        'glam-black': '#101010',
                    },
                    fontFamily: {
                        sans: ['Satoshi', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-glam-gray text-glam-black font-sans antialiased min-h-screen flex">
    <!-- Sidebar -->
    <aside id="adminSidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-glam-black text-white flex flex-col transform -translate-x-full md:translate-x-0 md:static transition-transform duration-200 shrink-0">
        <div class="px-6 py-5 border-b border-neutral-800 flex items-center justify-between">
            <a asp-controller="Admin" asp-action="Dashboard" class="text-sm font-bold tracking-[0.16em] uppercase text-white">
                GLAMORA <span class="text-glam-brown">ADMIN</span>
            </a>
            <button type="button" onclick="document.getElementById('adminSidebar').classList.add('-translate-x-full')" class="md:hidden text-neutral-400 hover:text-white">
                &times;
            </button>
        </div>

        <nav class="flex-1 px-4 py-5 space-y-1 text-xs font-medium overflow-y-auto">
            <div class="px-3 pb-2 text-[10px] font-bold uppercase tracking-widest text-neutral-500">Overview</div>
            <a asp-controller="Admin" asp-action="Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-neutral-200 hover:bg-white/10 hover:text-white transition">
                <span>Dashboard</span>
            </a>

            <div class="px-3 pt-4 pb-2 text-[10px] font-bold uppercase tracking-widest text-neutral-500">Management</div>
            <a asp-controller="User" asp-action="UserList" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-neutral-200 hover:bg-white/10 hover:text-white transition">
                <span>Users</span>
            </a>
            <a asp-controller="Product" asp-action="ProductList" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-neutral-200 hover:bg-white/10 hover:text-white transition">
                <span>Products</span>
            </a>
            <a asp-controller="Category" asp-action="CategoryList" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-neutral-200 hover:bg-white/10 hover:text-white transition">
                <span>Categories</span>
            </a>

            <div class="px-3 pt-4 pb-2 text-[10px] font-bold uppercase tracking-widest text-neutral-500">Store &amp; Finance</div>
            <a asp-controller="Shop" asp-action="ShopList" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-neutral-200 hover:bg-white/10 hover:text-white transition">
                <span>Shops</span>
            </a>
            <a asp-controller="Order" asp-action="OrderList" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-neutral-200 hover:bg-white/10 hover:text-white transition">
                <span>Orders</span>
            </a>
            <a asp-controller="Payment" asp-action="PaymentList" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-neutral-200 hover:bg-white/10 hover:text-white transition">
                <span>Payments</span>
            </a>
            <a asp-controller="Wallet" asp-action="WalletList" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-neutral-200 hover:bg-white/10 hover:text-white transition">
                <span>Wallets</span>
            </a>

            <div class="px-3 pt-4 pb-2 text-[10px] font-bold uppercase tracking-widest text-neutral-500">System</div>
            <a asp-controller="Media" asp-action="MediaList" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-neutral-200 hover:bg-white/10 hover:text-white transition">
                <span>Media</span>
            </a>
            <a asp-controller="Notification" asp-action="NotificationList" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-neutral-200 hover:bg-white/10 hover:text-white transition">
                <span>Notifications</span>
            </a>
        </nav>

        <div class="p-4 border-t border-neutral-800">
            <div class="flex items-center justify-between gap-2 mb-3">
                <div class="text-xs font-semibold text-white truncate">@User.Identity?.Name</div>
                <span class="rounded-full bg-glam-brown/25 text-[#e6ddd2] px-2.5 py-0.5 text-[10px] font-bold uppercase">Admin</span>
            </div>
            <a asp-controller="Login" asp-action="Logout" class="block w-full text-center rounded-full border border-white/30 py-2 text-xs font-semibold text-white hover:bg-white hover:text-glam-black transition">
                Logout
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
        <header class="bg-white border-b border-neutral-200 px-4 sm:px-8 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <button type="button" onclick="document.getElementById('adminSidebar').classList.toggle('-translate-x-full')" class="md:hidden rounded-lg border border-neutral-300 px-2.5 py-1.5 text-xs font-bold">
                    &#9776;
                </button>
                <span class="text-xs font-bold uppercase tracking-widest text-neutral-500">@ViewData["Title"]</span>
            </div>
            <a asp-controller="Home" asp-action="Index" class="text-xs font-semibold text-glam-black hover:text-glam-brown transition">ดูหน้าร้าน &nearr;</a>
        </header>

        <main role="main" class="flex-1 p-4 sm:p-8 max-w-6xl w-full mx-auto">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
