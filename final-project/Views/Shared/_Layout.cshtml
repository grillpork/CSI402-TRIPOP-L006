<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GLAMORA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'glam-brown': '#978877',
                        'glam-gray': '#F5F5F5',
                        'glam-black': '#101010',
                    },
                    fontFamily: {
                        sans: ['Satoshi', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-white text-glam-black font-sans antialiased min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 bg-white border-b border-neutral-100">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4">
            <div class="flex items-center justify-between gap-4">
                <nav class="flex items-center gap-6">
                    <a class="text-xs font-medium tracking-widest uppercase text-neutral-500 hover:text-glam-black transition" asp-controller="Home" asp-action="Index">HOME</a>
                    <a class="text-xs font-bold tracking-widest uppercase text-glam-black hover:text-glam-brown transition" asp-controller="Product" asp-action="ProductList">SHOP</a>
                    <a class="hidden md:inline text-xs font-medium tracking-widest uppercase text-neutral-500 hover:text-glam-black transition" asp-controller="Shop" asp-action="RegisterShop">SELLER</a>
                    <a class="hidden md:inline text-xs font-medium tracking-widest uppercase text-neutral-500 hover:text-glam-black transition" asp-controller="Order" asp-action="OrderList">ORDERS</a>
                </nav>

                <a class="inline-flex items-center gap-2 text-base font-bold tracking-[0.16em] text-glam-black uppercase" asp-controller="Home" asp-action="Index">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                    <span>GLAMORA</span>
                </a>

                <div class="flex items-center gap-3">
                    <a class="inline-flex items-center gap-2 border border-neutral-300 rounded-full px-4 py-1.5 text-xs font-semibold tracking-wider text-glam-black hover:bg-glam-black hover:text-white hover:border-glam-black transition" asp-controller="Cart" asp-action="CartList">
                        <span>MY CART</span>
                    </a>
                    <a asp-controller="Login" asp-action="Login" class="text-xs font-medium tracking-widest uppercase text-neutral-600 hover:text-glam-black transition">LOGIN</a>
                </div>
            </div>
        </div>
    </header>

    <div class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-6">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
