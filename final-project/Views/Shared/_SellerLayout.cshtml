<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Seller Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'glam-brown': '#978877',
                        'glam-gray': '#F5F5F5',
                        'glam-black': '#101010',
                    },
                    fontFamily: {
                        sans: ['Satoshi', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-glam-gray text-glam-black font-sans antialiased min-h-screen flex flex-col">
    <header class="bg-glam-brown text-white border-b border-black/10 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <a class="text-sm font-bold tracking-[0.14em] uppercase text-white" asp-controller="Product" asp-action="ProductList">SELLER CENTER</a>

                <nav class="flex flex-wrap items-center gap-5 text-xs font-medium tracking-wide">
                    <a class="text-white/85 hover:text-white transition" asp-controller="Product" asp-action="ProductList">Products</a>
                    <a class="text-white/85 hover:text-white transition" asp-controller="Shop" asp-action="ShopList">My Shops</a>
                    <a class="text-white/85 hover:text-white transition" asp-controller="Wallet" asp-action="WalletList">Shop Wallets</a>
                    <a class="text-white/85 hover:text-white transition" asp-controller="Order" asp-action="OrderList">Orders</a>
                    <a class="text-white/85 hover:text-white transition" asp-controller="Media" asp-action="MediaList">Media</a>
                    <a class="text-white/85 hover:text-white transition" asp-controller="Notification" asp-action="NotificationList">Notifications</a>
                </nav>

                <div class="flex items-center gap-3">
                    <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white">Seller: @User.Identity?.Name</span>
                    <a asp-controller="Login" asp-action="Logout" class="rounded-full border border-white/50 px-4 py-1.5 text-xs font-semibold text-white hover:bg-white hover:text-glam-black transition">Logout</a>
                </div>
            </div>
        </div>
    </header>

    <div class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-8">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
