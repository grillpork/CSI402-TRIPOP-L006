@model List<final_project.Models.Order>
@{
    ViewData["Title"] = "Order List";
}

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-bold uppercase tracking-tight text-glam-black">รายการคำสั่งซื้อ (Order List)</h1>
        <p class="text-xs text-neutral-500 mt-1">ติดตามและจัดการคำสั่งซื้อทั้งหมด</p>
    </div>
    <a asp-action="Checkout" class="rounded-full bg-glam-black text-white px-5 py-2.5 text-xs font-semibold uppercase tracking-wider hover:bg-glam-brown transition">ไปหน้า Checkout</a>
</div>

<div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-glam-gray border-b border-neutral-200 text-xs uppercase tracking-wider text-neutral-600">
                <tr>
                    <th class="px-4 py-3.5">OrderId</th>
                    <th class="px-4 py-3.5">ผู้สั่งซื้อ (User)</th>
                    <th class="px-4 py-3.5">วิธีชำระเงิน</th>
                    <th class="px-4 py-3.5">ยอดรวม</th>
                    <th class="px-4 py-3.5">สถานะ</th>
                    <th class="px-4 py-3.5">วันที่สั่งซื้อ</th>
                    <th class="px-4 py-3.5 text-right">จัดการ</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100">
                @foreach (var order in Model)
                {
                    var badgeClass = order.Status == "Paid" || order.Status == "Completed"
                        ? "bg-emerald-50 text-emerald-700 border-emerald-200"
                        : order.Status == "Cancelled"
                            ? "bg-red-50 text-red-600 border-red-200"
                            : "bg-amber-50 text-amber-700 border-amber-200";
                    <tr class="hover:bg-glam-gray/50 transition">
                        <td class="px-4 py-3 font-semibold text-glam-black">#@order.OrderId</td>
                        <td class="px-4 py-3 text-neutral-600">@(order.User?.UserName ?? $"User #{order.UserId}")</td>
                        <td class="px-4 py-3 text-neutral-600">@order.PaymentMethod</td>
                        <td class="px-4 py-3 font-semibold text-glam-brown">฿@order.TotalAmount.ToString("N2")</td>
                        <td class="px-4 py-3">
                            <span class="rounded-full border px-3 py-0.5 text-xs font-semibold @badgeClass">@order.Status</span>
                        </td>
                        <td class="px-4 py-3 text-neutral-500 text-xs">@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="px-4 py-3 text-right space-x-1 whitespace-nowrap">
                            @if (order.Status == "Pending")
                            {
                                <a asp-controller="Payment" asp-action="Pay" asp-route-orderId="@order.OrderId" class="inline-block rounded-full bg-emerald-600 text-white px-3 py-1 text-xs font-semibold hover:bg-emerald-700 transition">ชำระเงิน</a>
                            }
                            <a asp-action="OrderDetails" asp-route-id="@order.OrderId" class="inline-block rounded-full border border-neutral-300 px-3 py-1 text-xs font-medium text-glam-black hover:bg-glam-gray transition">ดูรายละเอียด</a>
                            <a asp-action="EditOrder" asp-route-id="@order.OrderId" class="inline-block rounded-full border border-glam-black px-3 py-1 text-xs font-medium text-glam-black hover:bg-glam-black hover:text-white transition">แก้ไข</a>
                            <form asp-action="DeleteOrder" asp-route-id="@order.OrderId" method="post" class="inline">
                                <button type="submit" class="rounded-full border border-red-300 px-3 py-1 text-xs font-medium text-red-600 hover:bg-red-600 hover:text-white transition">ลบ</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
