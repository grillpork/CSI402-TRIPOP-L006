@model final_project.Models.Order
@{
    ViewData["Title"] = "Order Details";
}

<div class="max-w-2xl mx-auto mt-6 bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm">
    <h1 class="text-xl font-bold uppercase tracking-tight text-glam-black mb-6">รายละเอียดคำสั่งซื้อ #@Model?.OrderId</h1>

    @if (Model != null)
    {
        <dl class="divide-y divide-neutral-100 text-sm mb-6">
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">ผู้สั่งซื้อ</dt><dd class="font-semibold">@(Model.User?.UserName ?? $"User #{Model.UserId}")</dd></div>
            <div class="py-2.5 flex justify-between gap-4"><dt class="text-neutral-500 shrink-0">ที่อยู่จัดส่ง</dt><dd class="text-right">@Model.ShippingAddress</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">วิธีชำระเงิน</dt><dd>@Model.PaymentMethod</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">สถานะ</dt><dd><span class="rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-0.5 text-xs font-semibold">@Model.Status</span></dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">วันที่สั่งซื้อ</dt><dd class="text-neutral-500">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd></div>
        </dl>

        <h2 class="text-sm font-bold uppercase tracking-wider text-glam-black mb-3">รายการสินค้า</h2>
        <div class="overflow-x-auto border border-neutral-200 rounded-xl mb-6">
            <table class="w-full text-left text-sm">
                <thead class="bg-glam-gray border-b border-neutral-200 text-xs uppercase tracking-wider text-neutral-600">
                    <tr>
                        <th class="px-4 py-3">สินค้า</th>
                        <th class="px-4 py-3">ราคาต่อชิ้น</th>
                        <th class="px-4 py-3">จำนวน</th>
                        <th class="px-4 py-3 text-right">รวม</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-neutral-100">
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td class="px-4 py-3 font-medium">@(item.Product?.ProductName ?? $"Product #{item.ProductId}")</td>
                            <td class="px-4 py-3 text-neutral-600">฿@item.Price.ToString("N2")</td>
                            <td class="px-4 py-3">@item.Quantity</td>
                            <td class="px-4 py-3 text-right font-semibold">฿@((item.Price * item.Quantity).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="border-t-2 border-neutral-200 bg-glam-gray/40">
                    <tr>
                        <th colspan="3" class="px-4 py-3 text-right text-xs uppercase tracking-wider text-neutral-500">ยอดรวมทั้งหมด</th>
                        <th class="px-4 py-3 text-right text-base font-bold text-glam-brown">฿@Model.TotalAmount.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    <div class="flex flex-wrap gap-3">
        <a asp-action="OrderList" class="rounded-full border border-neutral-300 px-5 py-2 text-xs font-semibold text-glam-black hover:border-glam-black transition">ดูรายการคำสั่งซื้อทั้งหมด</a>
        @if (Model != null && Model.Status == "Pending")
        {
            <a asp-controller="Payment" asp-action="Pay" asp-route-orderId="@Model.OrderId" class="rounded-full bg-emerald-600 text-white px-5 py-2 text-xs font-semibold hover:bg-emerald-700 transition">ไปชำระเงิน</a>
        }
    </div>
</div>
