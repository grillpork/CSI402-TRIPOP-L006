@model final_project.Models.Order
@{
    ViewData["Title"] = "Checkout";
    var users = ViewBag.Users as List<final_project.Models.User> ?? new List<final_project.Models.User>();
    var carts = ViewBag.Carts as List<final_project.Models.Cart> ?? new List<final_project.Models.Cart>();
    decimal totalAmount = ViewBag.TotalAmount ?? 0m;
}

<h1 class="text-2xl font-bold uppercase tracking-tight text-glam-black mb-6">ชำระเงิน / สั่งซื้อสินค้า (Checkout)</h1>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <div class="lg:col-span-7 bg-white rounded-2xl border border-neutral-200 p-6 shadow-sm">
        <h2 class="text-base font-bold uppercase tracking-wider text-glam-black mb-4">สรุปรายการสินค้าในตะกร้า</h2>

        @if (carts.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-glam-gray border-b border-neutral-200 text-xs uppercase tracking-wider text-neutral-600">
                        <tr>
                            <th class="px-4 py-3">สินค้า</th>
                            <th class="px-4 py-3">ราคา</th>
                            <th class="px-4 py-3">จำนวน</th>
                            <th class="px-4 py-3 text-right">รวม</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-neutral-100">
                        @foreach (var item in carts)
                        {
                            <tr>
                                <td class="px-4 py-3 font-medium">@(item.Product?.ProductName ?? $"Product #{item.ProductId}")</td>
                                <td class="px-4 py-3 text-neutral-600">฿@(item.Product?.Price.ToString("N2") ?? "0.00")</td>
                                <td class="px-4 py-3">@item.Quantity</td>
                                <td class="px-4 py-3 text-right font-semibold">฿@(((item.Product?.Price ?? 0) * item.Quantity).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="border-t-2 border-neutral-200">
                        <tr>
                            <th colspan="3" class="px-4 py-3 text-right text-xs uppercase tracking-wider text-neutral-500">ยอดรวมทั้งหมด</th>
                            <th class="px-4 py-3 text-right text-lg font-bold text-glam-brown">฿@totalAmount.ToString("N2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <p class="text-sm text-neutral-500 mb-4">ยังไม่มีสินค้าในตะกร้า</p>
            <a asp-controller="Cart" asp-action="CreateCart" class="inline-block rounded-full border border-glam-black px-5 py-2 text-xs font-semibold text-glam-black hover:bg-glam-black hover:text-white transition">เพิ่มสินค้าลงตะกร้า</a>
        }
    </div>

    <div class="lg:col-span-5 bg-white rounded-2xl border border-neutral-200 p-6 shadow-sm h-fit">
        <h2 class="text-base font-bold uppercase tracking-wider text-glam-black mb-4">ข้อมูลการจัดส่งและชำระเงิน</h2>

        <form asp-action="Checkout" method="post" class="space-y-4">
            <div>
                <label asp-for="UserId" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">ผู้สั่งซื้อ (User)</label>
                <select asp-for="UserId" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black">
                    @foreach (var u in users)
                    {
                        <option value="@u.UserId">@u.UserName (@u.Email)</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="ShippingAddress" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">ที่อยู่จัดส่ง (ShippingAddress)</label>
                <textarea asp-for="ShippingAddress" rows="3" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black" placeholder="กรอกที่อยู่จัดส่ง..."></textarea>
            </div>
            <div>
                <label asp-for="PaymentMethod" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">วิธีชำระเงิน (PaymentMethod)</label>
                <select asp-for="PaymentMethod" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black">
                    <option value="PromptPay">PromptPay</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                    <option value="Credit Card">Credit Card</option>
                    <option value="Cash on Delivery">Cash on Delivery (เก็บเงินปลายทาง)</option>
                </select>
            </div>

            <button type="submit" class="w-full rounded-full bg-glam-black text-white py-3 text-xs font-semibold uppercase tracking-wider hover:bg-glam-brown transition disabled:opacity-40 disabled:cursor-not-allowed" @(carts.Any() ? "" : "disabled")>
                ยืนยันการสั่งซื้อ (Checkout)
            </button>
        </form>
    </div>
</div>
