@model final_project.Models.Payment
@{
    ViewData["Title"] = "Payment Success";
}

<div class="max-w-md mx-auto mt-10 bg-white rounded-2xl border border-emerald-200 p-8 text-center shadow-sm">
    <div class="w-14 h-14 rounded-full bg-emerald-50 text-emerald-600 mx-auto mb-3 flex items-center justify-center text-2xl font-bold">&#10004;</div>
    <h1 class="text-2xl font-bold text-emerald-700 mb-1">ชำระเงินสำเร็จ!</h1>
    <p class="text-xs text-neutral-500 mb-6">(Demo Payment Completed)</p>

    @if (Model != null)
    {
        <dl class="divide-y divide-neutral-100 text-sm text-left mb-6">
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">PaymentId</dt><dd class="font-medium">#@Model.PaymentId</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">OrderId</dt><dd class="font-medium">#@Model.OrderId</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">ผู้สั่งซื้อ</dt><dd class="font-semibold">@(Model.Order?.User?.UserName ?? "-")</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">ช่องทางชำระเงิน</dt><dd>@Model.PaymentMethod</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">ยอดที่ชำระ</dt><dd class="font-bold text-emerald-600">฿@Model.Amount.ToString("N2")</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">สถานะ</dt><dd><span class="rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-0.5 text-xs font-semibold">@Model.Status</span></dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">เวลาที่ชำระ</dt><dd class="text-neutral-500">@Model.PaidAt.ToString("yyyy-MM-dd HH:mm")</dd></div>
        </dl>
    }

    <div class="flex flex-wrap justify-center gap-3">
        <a asp-controller="Order" asp-action="OrderDetails" asp-route-id="@Model?.OrderId" class="rounded-full bg-glam-black text-white px-5 py-2.5 text-xs font-semibold hover:bg-glam-brown transition">ดูรายละเอียดคำสั่งซื้อ</a>
        <a asp-action="PaymentList" class="rounded-full border border-neutral-300 px-5 py-2.5 text-xs font-semibold text-glam-black hover:border-glam-black transition">ประวัติการชำระเงิน</a>
    </div>
</div>
