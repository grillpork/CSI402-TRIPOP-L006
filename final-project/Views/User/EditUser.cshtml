@model final_project.Models.User
@{
    ViewData["Title"] = "Edit User";
    var roles = ViewBag.Roles as List<final_project.Models.Role> ?? new List<final_project.Models.Role>();
}

<div class="max-w-lg mx-auto mt-6 bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm">
    <h1 class="text-xl font-bold uppercase tracking-tight text-glam-black mb-6">แก้ไขผู้ใช้ (EditUser)</h1>

    <form asp-action="EditUser" method="post" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="ImageUrl" />

        <div>
            <label asp-for="UserName" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">UserName</label>
            <input asp-for="UserName" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black" />
        </div>
        <div>
            <label asp-for="Email" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">Email</label>
            <input asp-for="Email" type="email" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black" />
        </div>
        <div>
            <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">Password</label>
            <input asp-for="Password" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black" />
        </div>
        <div>
            <label asp-for="RoleId" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">Role</label>
            <select asp-for="RoleId" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black">
                @foreach (var r in roles)
                {
                    <option value="@r.RoleId">@r.RoleName</option>
                }
            </select>
        </div>

        @if (!string.IsNullOrEmpty(Model?.ImageUrl))
        {
            <div>
                <div class="text-xs text-neutral-500 mb-1">รูปโปรไฟล์ปัจจุบัน</div>
                <img src="@Model.ImageUrl" alt="Profile Image" class="w-24 h-24 rounded-full object-cover border border-neutral-200" />
            </div>
        }

        <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">เปลี่ยนรูปโปรไฟล์ (Upload Image)</label>
            <input type="file" name="imageFile" accept="image/*" class="w-full rounded-xl border border-neutral-300 px-4 py-2 text-sm file:mr-4 file:rounded-full file:border-0 file:bg-glam-black file:px-4 file:py-1.5 file:text-xs file:font-semibold file:text-white hover:file:bg-glam-brown" />
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="rounded-full bg-glam-black text-white px-6 py-2.5 text-xs font-semibold uppercase tracking-wider hover:bg-glam-brown transition">บันทึกการแก้ไข</button>
            <a asp-action="UserList" class="rounded-full border border-neutral-300 px-6 py-2.5 text-xs font-medium text-neutral-700 hover:border-glam-black transition">ยกเลิก</a>
        </div>
    </form>
</div>
