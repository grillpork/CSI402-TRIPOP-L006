@model final_project.Models.Shop
@{
    ViewData["Title"] = "Edit Shop";
    var users = ViewBag.Users as List<final_project.Models.User> ?? new List<final_project.Models.User>();
}

<div class="max-w-xl mx-auto mt-6 bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm">
    <h1 class="text-xl font-bold uppercase tracking-tight text-glam-black mb-6">แก้ไขข้อมูลร้านค้า (EditShop)</h1>

    <form asp-action="EditShop" method="post" class="space-y-4">
        <input type="hidden" asp-for="ShopId" />
        <input type="hidden" asp-for="CreatedAt" />
        <div>
            <label asp-for="UserId" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">เจ้าของร้าน (User)</label>
            <select asp-for="UserId" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black">
                @foreach (var u in users)
                {
                    <option value="@u.UserId">@u.UserName (@u.Email)</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="ShopName" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">ชื่อร้านค้า (ShopName)</label>
            <input asp-for="ShopName" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black" />
        </div>
        <div>
            <label asp-for="Phone" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">เบอร์โทรติดต่อ (Phone)</label>
            <input asp-for="Phone" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black" />
        </div>
        <div>
            <label asp-for="Address" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">ที่อยู่ร้านค้า (Address)</label>
            <input asp-for="Address" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black" />
        </div>
        <div>
            <label asp-for="Description" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">รายละเอียดร้านค้า (Description)</label>
            <textarea asp-for="Description" rows="3" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black"></textarea>
        </div>
        <div class="flex gap-3 pt-2">
            <button type="submit" class="rounded-full bg-glam-black text-white px-6 py-2.5 text-xs font-semibold uppercase tracking-wider hover:bg-glam-brown transition">บันทึกการแก้ไข</button>
            <a asp-action="ShopList" class="rounded-full border border-neutral-300 px-6 py-2.5 text-xs font-medium text-neutral-700 hover:border-glam-black transition">ยกเลิก</a>
        </div>
    </form>
</div>
