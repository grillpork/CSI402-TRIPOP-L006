@model final_project.Models.UserViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="max-w-lg mx-auto my-4 sm:my-8">
    <div class="rounded-3xl bg-white border border-neutral-200/90 shadow-sm p-6 sm:p-10 flex flex-col justify-between">
        <div>
            <!-- Mode Switcher Tabs -->
            <div class="bg-glam-gray p-1 rounded-full grid grid-cols-2 mb-8" role="tablist" aria-label="Authentication mode">
                    <a asp-controller="Login" asp-action="Login" role="tab" aria-selected="false"
                       class="rounded-full py-2 px-4 text-center text-xs font-semibold text-neutral-500 hover:text-glam-black transition">
                        เข้าสู่ระบบ (Login)
                    </a>
                    <a asp-controller="Login" asp-action="Register" role="tab" aria-selected="true"
                       class="rounded-full bg-glam-black text-white py-2 px-4 text-center text-xs font-semibold tracking-wider transition">
                        สมัครสมาชิก (Register)
                    </a>
                </div>

                <div class="mb-6">
                    <h1 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-glam-black">สมัครสมาชิก (Register)</h1>
                    <p class="text-xs sm:text-sm text-neutral-500 mt-1">สร้างบัญชีใหม่เพื่อเริ่มเลือกช้อปสินค้าแฟชั่นบน GLAMORA</p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div role="alert" class="mb-5 flex items-start gap-2.5 rounded-2xl bg-red-50 border border-red-200 px-4 py-3 text-xs text-red-700">
                        <svg class="w-4 h-4 text-red-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>@ViewBag.ErrorMessage</span>
                    </div>
                }

                <form asp-controller="Login" asp-action="Register" method="post" id="registerForm" class="space-y-5">
                    <!-- 1. Email -->
                    <div>
                        <label asp-for="Email" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-2">
                            อีเมล (Email) <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-0 pl-4 flex items-center text-neutral-400">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            </span>
                            <input asp-for="Email" type="email" required autocomplete="email" placeholder="name@example.com"
                                   class="w-full rounded-xl bg-glam-gray/70 border border-neutral-300 pl-11 pr-4 py-3 text-sm text-glam-black placeholder:text-neutral-400 focus:outline-none focus:bg-white focus:border-glam-black transition" />
                        </div>
                    </div>

                    <!-- 2. Password -->
                    <div>
                        <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-2">
                            รหัสผ่าน (Password) <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-0 pl-4 flex items-center text-neutral-400">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                            <input asp-for="Password" id="regPassword" type="password" required autocomplete="new-password" placeholder="อย่างน้อย 6 ตัวอักษร"
                                   oninput="evaluatePasswordStrength()"
                                   class="w-full rounded-xl bg-glam-gray/70 border border-neutral-300 pl-11 pr-12 py-3 text-sm text-glam-black placeholder:text-neutral-400 focus:outline-none focus:bg-white focus:border-glam-black transition" />
                            <button type="button" onclick="toggleFieldVisibility('regPassword', 'regEyeOpen', 'regEyeClosed')" aria-label="แสดงหรือซ่อนรหัสผ่าน"
                                    class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-neutral-400 hover:text-glam-black transition">
                                <svg id="regEyeOpen" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg id="regEyeClosed" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>

                        <!-- 4-Segment Password Strength Meter -->
                        <div class="mt-2.5">
                            <div class="grid grid-cols-4 gap-1.5" aria-hidden="true">
                                <div id="strBar1" class="h-1 rounded-full bg-neutral-200 transition-colors"></div>
                                <div id="strBar2" class="h-1 rounded-full bg-neutral-200 transition-colors"></div>
                                <div id="strBar3" class="h-1 rounded-full bg-neutral-200 transition-colors"></div>
                                <div id="strBar4" class="h-1 rounded-full bg-neutral-200 transition-colors"></div>
                            </div>
                            <p id="strLabel" class="text-[11px] text-neutral-400 mt-1">ความปลอดภัยรหัสผ่าน: รอการกรอกข้อมูล</p>
                        </div>
                    </div>

                    <!-- 3. Confirm Password -->
                    <div>
                        <label for="confirmPassword" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-2">
                            ยืนยันรหัสผ่าน (Confirm Password) <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-0 pl-4 flex items-center text-neutral-400">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </span>
                            <input id="confirmPassword" type="password" required autocomplete="new-password" placeholder="กรอกรหัสผ่านอีกครั้ง"
                                   oninput="checkPasswordMatch()"
                                   class="w-full rounded-xl bg-glam-gray/70 border border-neutral-300 pl-11 pr-12 py-3 text-sm text-glam-black placeholder:text-neutral-400 focus:outline-none focus:bg-white focus:border-glam-black transition" />
                            <button type="button" onclick="toggleFieldVisibility('confirmPassword', 'confirmEyeOpen', 'confirmEyeClosed')" aria-label="แสดงหรือซ่อนรหัสผ่านยืนยัน"
                                    class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-neutral-400 hover:text-glam-black transition">
                                <svg id="confirmEyeOpen" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg id="confirmEyeClosed" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                        <p id="matchFeedback" class="text-[11px] text-neutral-400 mt-1.5">กรุณากรอกให้ตรงกับรหัสผ่านด้านบน</p>
                    </div>

                    <!-- Terms & Conditions -->
                    <div class="pt-1">
                        <label class="inline-flex items-start gap-2.5 cursor-pointer text-xs text-neutral-600 select-none">
                            <input type="checkbox" id="acceptTerms" required class="mt-0.5 w-4 h-4 rounded border-neutral-300 accent-glam-black" />
                            <span>ฉันยอมรับ <a asp-controller="Home" asp-action="Privacy" class="font-semibold text-glam-black underline hover:text-glam-brown">ข้อกำหนดการใช้งานและนโยบายความเป็นส่วนตัว</a> ของ GLAMORA</span>
                        </label>
                    </div>

                    <button type="submit"
                            class="w-full rounded-full bg-glam-black text-white py-3.5 px-6 text-xs font-semibold uppercase tracking-widest hover:bg-glam-brown transition inline-flex items-center justify-center gap-2">
                        <span>สมัครสมาชิก / CREATE ACCOUNT</span>
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>
                </form>
            </div>

            <div class="mt-8 pt-5 border-t border-neutral-100 text-center text-xs text-neutral-500">
                มีบัญชีอยู่แล้ว?
                <a asp-controller="Login" asp-action="Login" class="font-semibold text-glam-black hover:text-glam-brown underline ml-1">
                    เข้าสู่ระบบที่นี่
                </a>
            </div>
    </div>
</section>

@section Scripts {
    <script>
        function toggleFieldVisibility(inputId, openId, closedId) {
            const input = document.getElementById(inputId);
            const openIcon = document.getElementById(openId);
            const closedIcon = document.getElementById(closedId);
            if (!input) return;

            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            openIcon.classList.toggle('hidden', isPassword);
            closedIcon.classList.toggle('hidden', !isPassword);
        }

        function evaluatePasswordStrength() {
            const pwd = document.getElementById('regPassword').value || '';
            let score = 0;
            if (pwd.length >= 6) score++;
            if (pwd.length >= 10) score++;
            if (/[A-Z]/.test(pwd) && /[a-z]/.test(pwd)) score++;
            if (/[0-9]/.test(pwd) || /[^A-Za-z0-9]/.test(pwd)) score++;

            const bars = ['strBar1', 'strBar2', 'strBar3', 'strBar4'].map(id => document.getElementById(id));
            const label = document.getElementById('strLabel');
            const colors = ['bg-red-500', 'bg-amber-500', 'bg-glam-brown', 'bg-emerald-600'];
            const labels = [
                'ความปลอดภัยรหัสผ่าน: อ่อน (Weak)',
                'ความปลอดภัยรหัสผ่าน: ปานกลาง (Fair)',
                'ความปลอดภัยรหัสผ่าน: ดี (Good)',
                'ความปลอดภัยรหัสผ่าน: แข็งแรง (Strong)'
            ];

            bars.forEach((bar, idx) => {
                bar.classList.remove('bg-red-500', 'bg-amber-500', 'bg-glam-brown', 'bg-emerald-600', 'bg-neutral-200');
                if (pwd.length > 0 && idx < score) {
                    bar.classList.add(colors[Math.max(0, score - 1)]);
                } else {
                    bar.classList.add('bg-neutral-200');
                }
            });

            if (pwd.length === 0) {
                label.textContent = 'ความปลอดภัยรหัสผ่าน: รอการกรอกข้อมูล';
                label.className = 'text-[11px] text-neutral-400 mt-1';
            } else {
                const level = Math.max(1, score);
                label.textContent = labels[level - 1];
                label.className = 'text-[11px] font-medium mt-1 ' + (level <= 1 ? 'text-red-600' : level === 2 ? 'text-amber-600' : level === 3 ? 'text-glam-brown' : 'text-emerald-600');
            }

            checkPasswordMatch();
        }

        function checkPasswordMatch() {
            const pwd = document.getElementById('regPassword').value || '';
            const confirmInput = document.getElementById('confirmPassword');
            const confirm = confirmInput.value || '';
            const feedback = document.getElementById('matchFeedback');

            if (!confirm) {
                feedback.textContent = 'กรุณากรอกให้ตรงกับรหัสผ่านด้านบน';
                feedback.className = 'text-[11px] text-neutral-400 mt-1.5';
                confirmInput.setCustomValidity('');
                return;
            }

            if (pwd === confirm) {
                feedback.textContent = 'รหัสผ่านตรงกันเรียบร้อย';
                feedback.className = 'text-[11px] font-medium text-emerald-600 mt-1.5';
                confirmInput.setCustomValidity('');
            } else {
                feedback.textContent = 'รหัสผ่านยังไม่ตรงกัน กรุณาตรวจสอบอีกครั้ง';
                feedback.className = 'text-[11px] font-medium text-red-600 mt-1.5';
                confirmInput.setCustomValidity('รหัสผ่านไม่ตรงกัน');
            }
        }

        document.getElementById('registerForm')?.addEventListener('submit', function (e) {
            checkPasswordMatch();
            const confirmInput = document.getElementById('confirmPassword');
            if (confirmInput && !confirmInput.checkValidity()) {
                e.preventDefault();
                confirmInput.reportValidity();
            }
        });
    </script>
}
