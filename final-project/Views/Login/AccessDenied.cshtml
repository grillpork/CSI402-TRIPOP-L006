@{
    ViewData["Title"] = "Access Denied";
}

<div class="max-w-lg mx-auto mt-12 bg-white rounded-2xl border border-red-200 p-8 text-center shadow-sm">
    <div class="w-12 h-12 rounded-full bg-red-50 text-red-600 mx-auto mb-4 flex items-center justify-center font-bold text-xl">!</div>
    <h1 class="text-xl font-bold text-glam-black mb-2">ไม่มีสิทธิ์เข้าถึงหน้านี้ (Access Denied)</h1>
    <p class="text-sm text-neutral-500 mb-6">บัญชีของคุณไม่มีสิทธิ์ใช้งานในส่วนนี้</p>
    <div class="flex justify-center gap-3">
        <a asp-controller="Home" asp-action="Index" class="rounded-full border border-neutral-300 px-5 py-2.5 text-xs font-semibold text-glam-black hover:border-glam-black transition">กลับหน้าหลัก</a>
        <a asp-controller="Login" asp-action="Login" class="rounded-full bg-glam-black text-white px-5 py-2.5 text-xs font-semibold hover:bg-glam-brown transition">สลับบัญชี (Login)</a>
    </div>
</div>
