@model List<final_project.Models.Product>
@{
    ViewData["Title"] = "Product List";
    var categories = ViewBag.Categories as List<final_project.Models.Category> ?? new List<final_project.Models.Category>();
    string? searchQuery = ViewBag.SearchQuery;
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
}

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-bold uppercase tracking-tight text-glam-black">รายการสินค้าเสื้อผ้า</h1>
        <p class="text-xs text-neutral-500 mt-1">เลือกชมและจัดการสินค้าแฟชั่นในร้าน</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Seller"))
    {
        <a asp-action="CreateProduct" class="rounded-full bg-glam-black text-white px-5 py-2.5 text-xs font-semibold uppercase tracking-wider hover:bg-glam-brown transition">+ เพิ่มเสื้อผ้าใหม่</a>
    }
</div>

<form asp-action="ProductList" method="get" class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-6 bg-white p-4 rounded-2xl border border-neutral-200">
    <div class="md:col-span-5">
        <input type="text" name="q" value="@searchQuery" class="w-full rounded-full bg-glam-gray border border-neutral-200 px-4 py-2 text-sm focus:outline-none focus:border-glam-black" placeholder="ค้นหาชื่อเสื้อผ้า, สี, ไซส์, หมวดหมู่..." />
    </div>
    <div class="md:col-span-4">
        <select name="categoryId" class="w-full rounded-full bg-glam-gray border border-neutral-200 px-4 py-2 text-sm focus:outline-none focus:border-glam-black">
            <option value="">-- ทุกหมวดหมู่ --</option>
            @foreach (var cat in categories)
            {
                <option value="@cat.CategoryId" selected="@(selectedCategoryId == cat.CategoryId)">@cat.CategoryName</option>
            }
        </select>
    </div>
    <div class="md:col-span-3 flex gap-2">
        <button type="submit" class="flex-1 rounded-full bg-glam-black text-white px-4 py-2 text-xs font-semibold uppercase tracking-wider hover:bg-glam-brown transition">ค้นหา</button>
        <a asp-action="ProductList" class="rounded-full border border-neutral-300 px-4 py-2 text-xs font-medium text-neutral-700 hover:border-glam-black transition inline-flex items-center">ล้างค่า</a>
    </div>
</form>

<div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-glam-gray border-b border-neutral-200 text-xs uppercase tracking-wider text-neutral-600">
                <tr>
                    <th class="px-4 py-3.5">ID</th>
                    <th class="px-4 py-3.5">รูปภาพ</th>
                    <th class="px-4 py-3.5">ชื่อสินค้า</th>
                    <th class="px-4 py-3.5">หมวดหมู่</th>
                    <th class="px-4 py-3.5">ไซส์</th>
                    <th class="px-4 py-3.5">สี</th>
                    <th class="px-4 py-3.5">เพศ</th>
                    <th class="px-4 py-3.5">ราคา</th>
                    <th class="px-4 py-3.5">สต็อก</th>
                    <th class="px-4 py-3.5 text-right">จัดการ</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-neutral-100">
                @foreach (var product in Model)
                {
                    <tr class="hover:bg-glam-gray/50 transition">
                        <td class="px-4 py-3 text-neutral-500">#@product.ProductId</td>
                        <td class="px-4 py-3">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.ProductName" class="w-12 h-12 object-cover rounded-xl border border-neutral-200" />
                            }
                            else
                            {
                                <div class="w-12 h-12 rounded-xl bg-glam-gray flex items-center justify-center text-[10px] text-neutral-400">No Img</div>
                            }
                        </td>
                        <td class="px-4 py-3 font-semibold text-glam-black">@product.ProductName</td>
                        <td class="px-4 py-3 text-neutral-600">@(product.Category?.CategoryName ?? "-")</td>
                        <td class="px-4 py-3"><span class="rounded-full bg-glam-gray px-2.5 py-0.5 text-xs font-medium">@product.Size</span></td>
                        <td class="px-4 py-3 text-neutral-600">@product.Color</td>
                        <td class="px-4 py-3 text-neutral-600">@product.Gender</td>
                        <td class="px-4 py-3 font-semibold text-glam-brown">฿@product.Price.ToString("N2")</td>
                        <td class="px-4 py-3 text-neutral-600">@product.Stock</td>
                        <td class="px-4 py-3 text-right space-x-1 whitespace-nowrap">
                            <a asp-action="Details" asp-route-id="@product.ProductId" class="inline-block rounded-full border border-neutral-300 px-3 py-1 text-xs font-medium text-glam-black hover:bg-glam-gray transition">ดู</a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Seller"))
                            {
                                <a asp-action="EditProduct" asp-route-id="@product.ProductId" class="inline-block rounded-full border border-glam-black px-3 py-1 text-xs font-medium text-glam-black hover:bg-glam-black hover:text-white transition">แก้ไข</a>
                                <form asp-action="DeleteProduct" asp-route-id="@product.ProductId" method="post" class="inline">
                                    <button type="submit" class="rounded-full border border-red-300 px-3 py-1 text-xs font-medium text-red-600 hover:bg-red-600 hover:text-white transition">ลบ</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
