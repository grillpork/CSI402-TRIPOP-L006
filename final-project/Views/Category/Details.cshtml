@model final_project.Models.Category
@{
    ViewData["Title"] = "Category Details";
}

<div class="max-w-lg mx-auto mt-6 bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm">
    <h1 class="text-xl font-bold uppercase tracking-tight text-glam-black mb-6">รายละเอียดหมวดหมู่ (Details)</h1>

    @if (Model != null)
    {
        <dl class="divide-y divide-neutral-100 text-sm mb-6">
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">CategoryId</dt><dd class="font-medium">#@Model.CategoryId</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">CategoryName</dt><dd class="font-semibold">@Model.CategoryName</dd></div>
            <div class="py-2.5 flex justify-between gap-4"><dt class="text-neutral-500 shrink-0">Description</dt><dd class="text-right text-neutral-600">@Model.Description</dd></div>
        </dl>
    }

    <a asp-action="CategoryList" class="inline-block rounded-full border border-neutral-300 px-5 py-2 text-xs font-semibold text-glam-black hover:border-glam-black transition">กลับหน้ารายการ</a>
</div>
