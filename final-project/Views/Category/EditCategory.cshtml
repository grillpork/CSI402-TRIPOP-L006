@model final_project.Models.Category
@{
    ViewData["Title"] = "Edit Category";
}

<div class="max-w-lg mx-auto mt-6 bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm">
    <h1 class="text-xl font-bold uppercase tracking-tight text-glam-black mb-6">แก้ไขหมวดหมู่ (EditCategory)</h1>

    <form asp-action="EditCategory" method="post" class="space-y-4">
        <input type="hidden" asp-for="CategoryId" />
        <div>
            <label asp-for="CategoryName" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">CategoryName</label>
            <input asp-for="CategoryName" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black" />
        </div>
        <div>
            <label asp-for="Description" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">Description</label>
            <textarea asp-for="Description" rows="3" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black"></textarea>
        </div>
        <div class="flex gap-3 pt-2">
            <button type="submit" class="rounded-full bg-glam-black text-white px-6 py-2.5 text-xs font-semibold uppercase tracking-wider hover:bg-glam-brown transition">บันทึกการแก้ไข</button>
            <a asp-action="CategoryList" class="rounded-full border border-neutral-300 px-6 py-2.5 text-xs font-medium text-neutral-700 hover:border-glam-black transition">ยกเลิก</a>
        </div>
    </form>
</div>
