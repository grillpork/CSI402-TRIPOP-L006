@model List<final_project.Models.Product>
@{
    ViewData["Title"] = "GLAMORA - Fashion Store";
    var categories = ViewBag.Categories as List<final_project.Models.Category> ?? new List<final_project.Models.Category>();
}

<!-- Hero Banner -->
<section class="rounded-3xl bg-gradient-to-br from-glam-gray via-white to-[#eee9e3] border border-neutral-200/70 px-6 sm:px-12 py-12 sm:py-16 mb-10">
    <div class="max-w-2xl">
        <span class="inline-block rounded-full bg-glam-brown/15 text-glam-brown px-3.5 py-1 text-xs font-semibold uppercase tracking-widest mb-4">New Season Collection</span>
        <h1 class="text-3xl sm:text-5xl font-bold uppercase tracking-tight text-glam-black leading-tight mb-4">
            TIMELESS FASHION<br />FOR EVERYDAY STYLE
        </h1>
        <p class="text-sm sm:text-base text-neutral-600 mb-7">
            คัดสรรเสื้อผ้าและแฟชั่นสไตล์มินิมอล คุณภาพดี สวมใส่สบาย พร้อมส่งตรงจากร้านค้าชั้นนำ
        </p>
        <div class="flex flex-wrap gap-3">
            <a asp-controller="Product" asp-action="ProductList" class="rounded-full bg-glam-black text-white px-7 py-3 text-xs font-semibold uppercase tracking-wider hover:bg-glam-brown transition">
                SHOP COLLECTION
            </a>
            <a asp-controller="Shop" asp-action="RegisterShop" class="rounded-full border border-glam-black text-glam-black px-7 py-3 text-xs font-semibold uppercase tracking-wider hover:bg-glam-black hover:text-white transition">
                BECOME A SELLER
            </a>
        </div>
    </div>
</section>

<!-- Category Pills -->
@if (categories.Any())
{
    <section class="mb-10">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold uppercase tracking-widest text-neutral-500">Categories</h2>
            <a asp-controller="Product" asp-action="ProductList" class="text-xs font-semibold text-glam-black hover:text-glam-brown transition">ดูทั้งหมด &rarr;</a>
        </div>
        <div class="flex flex-wrap gap-2.5">
            <a asp-controller="Product" asp-action="ProductList" class="rounded-full bg-glam-black text-white px-5 py-2 text-xs font-medium transition">ทั้งหมด</a>
            @foreach (var cat in categories)
            {
                <a asp-controller="Product" asp-action="ProductList" asp-route-categoryId="@cat.CategoryId" class="rounded-full border border-neutral-300 bg-white text-glam-black px-5 py-2 text-xs font-medium hover:bg-glam-black hover:text-white hover:border-glam-black transition">
                    @cat.CategoryName
                </a>
            }
        </div>
    </section>
}

<!-- Featured Products -->
<section>
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold uppercase tracking-tight text-glam-black">FEATURED PRODUCTS</h2>
        <a asp-controller="Product" asp-action="ProductList" class="text-xs font-semibold uppercase tracking-wider text-neutral-600 hover:text-glam-black transition">View All &rarr;</a>
    </div>

    @if (Model.Any())
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var p in Model)
            {
                <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId" class="group block">
                    <div class="bg-glam-gray rounded-2xl h-80 overflow-hidden flex items-center justify-center mb-3">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="@p.ProductName" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                        }
                        else
                        {
                            <span class="text-xs text-neutral-400 uppercase tracking-widest">No Image</span>
                        }
                    </div>
                    <div class="flex items-center justify-between gap-2">
                        <h3 class="text-sm font-bold uppercase tracking-wide text-glam-black truncate">@p.ProductName</h3>
                        <span class="text-sm font-semibold text-glam-brown shrink-0">฿@p.Price.ToString("N0")</span>
                    </div>
                    <div class="text-xs text-neutral-500 mt-0.5">@(p.Category?.CategoryName ?? "Fashion") &middot; @(p.Size ?? "M")</div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="rounded-2xl bg-glam-gray p-10 text-center">
            <p class="text-sm text-neutral-500 mb-4">ยังไม่มีสินค้าในระบบ</p>
            <a asp-controller="Product" asp-action="ProductList" class="inline-block rounded-full bg-glam-black text-white px-6 py-2.5 text-xs font-semibold uppercase tracking-wider hover:bg-glam-brown transition">ไปยังหน้าสินค้า</a>
        </div>
    }
</section>
