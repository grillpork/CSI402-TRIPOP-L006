@model final_project.Models.Review
@{
    ViewData["Title"] = "Edit Review";
    var products = ViewBag.Products as List<final_project.Models.Product> ?? new List<final_project.Models.Product>();
    var users = ViewBag.Users as List<final_project.Models.User> ?? new List<final_project.Models.User>();
}

<div class="max-w-lg mx-auto mt-6 bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm">
    <h1 class="text-xl font-bold uppercase tracking-tight text-glam-black mb-6">แก้ไขรีวิว (EditReview)</h1>

    <form asp-action="EditReview" method="post" class="space-y-4">
        <input type="hidden" asp-for="ReviewId" />
        <input type="hidden" asp-for="CreatedAt" />
        <div>
            <label asp-for="ProductId" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">สินค้า (Product)</label>
            <select asp-for="ProductId" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black">
                @foreach (var p in products)
                {
                    <option value="@p.ProductId">@p.ProductName</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="UserId" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">ผู้รีวิว (User)</label>
            <select asp-for="UserId" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black">
                @foreach (var u in users)
                {
                    <option value="@u.UserId">@u.UserName (@u.Email)</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="Rating" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">คะแนน (1 - 5)</label>
            <select asp-for="Rating" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black">
                <option value="5">5 ดาว</option>
                <option value="4">4 ดาว</option>
                <option value="3">3 ดาว</option>
                <option value="2">2 ดาว</option>
                <option value="1">1 ดาว</option>
            </select>
        </div>
        <div>
            <label asp-for="Comment" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 mb-1.5">ความคิดเห็น (Comment)</label>
            <textarea asp-for="Comment" rows="3" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 text-sm focus:outline-none focus:border-glam-black"></textarea>
        </div>
        <div class="flex gap-3 pt-2">
            <button type="submit" class="rounded-full bg-glam-black text-white px-6 py-2.5 text-xs font-semibold uppercase tracking-wider hover:bg-glam-brown transition">บันทึกการแก้ไข</button>
            <a asp-action="ReviewList" class="rounded-full border border-neutral-300 px-6 py-2.5 text-xs font-medium text-neutral-700 hover:border-glam-black transition">ยกเลิก</a>
        </div>
    </form>
</div>
