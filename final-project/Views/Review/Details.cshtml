@model final_project.Models.Review
@{
    ViewData["Title"] = "Review Details";
}

<div class="max-w-lg mx-auto mt-6 bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm">
    <h1 class="text-xl font-bold uppercase tracking-tight text-glam-black mb-6">รายละเอียดรีวิว (Details)</h1>

    @if (Model != null)
    {
        <dl class="divide-y divide-neutral-100 text-sm mb-6">
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">ReviewId</dt><dd class="font-medium">#@Model.ReviewId</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">สินค้า</dt><dd class="font-semibold">@(Model.Product?.ProductName ?? $"Product #{Model.ProductId}")</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">ผู้รีวิว</dt><dd>@(Model.User?.UserName ?? $"User #{Model.UserId}")</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">คะแนน</dt><dd class="text-amber-500 font-semibold">@Model.Rating / 5 ★</dd></div>
            <div class="py-2.5 flex justify-between gap-4"><dt class="text-neutral-500 shrink-0">ความคิดเห็น</dt><dd class="text-right text-neutral-600">@Model.Comment</dd></div>
            <div class="py-2.5 flex justify-between"><dt class="text-neutral-500">วันที่</dt><dd class="text-neutral-500">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd></div>
        </dl>
    }

    <a asp-action="ReviewList" class="inline-block rounded-full border border-neutral-300 px-5 py-2 text-xs font-semibold text-glam-black hover:border-glam-black transition">กลับหน้ารายการ</a>
</div>
